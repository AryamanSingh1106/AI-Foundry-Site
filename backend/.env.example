# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key-here

# Websites allowed to call the API (comma separated). Add your deployed site URL.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://your-site.vercel.app
